{
  // "ignores" is a markdownlint-cli2 option, not a lint rule, so it must live
  // in a -cli2 config file; in .markdownlint.json it was silently inert.
  "config": {
    "default": true,
    "MD009": false,
    "MD012": false,
    "MD013": false,
    "MD014": false,
    "MD022": false,
    "MD024": {
      "siblings_only": true
    },
    "MD029": false,
    "MD031": false,
    "MD032": false,
    "MD033": false,
    "MD034": false,
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD060": false
  },
  "ignores": ["repo/**"]
}
